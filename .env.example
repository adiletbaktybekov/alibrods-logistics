# ==============================================================================
# ALIBROS LOGISTICS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to .env.local for local development.
# 2. Never commit actual secret keys, passwords, or tokens to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"
NEXT_PUBLIC_API_URL="https://your-production-domain.com/api/v1"
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. DATABASE (MANDATORY IN PRODUCTION & STAGING)
# ------------------------------------------------------------------------------
# Pooled connection URL (Neon PgBouncer pooler endpoint, used by Next.js app runtime)
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>-pooler.c-7.eu-central-1.aws.neon.tech/<DB_NAME>?sslmode=require&channel_binding=require"

# Direct connection URL (Neon direct endpoint, used by Prisma Migrate for DDL & advisory locks)
DIRECT_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>.c-7.eu-central-1.aws.neon.tech/<DB_NAME>?sslmode=require&channel_binding=require"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Generate 256-bit secret via: `openssl rand -base64 32`
JWT_SECRET="<GENERATE_SECURE_RANDOM_BASE64_SECRET_MIN_32_CHARS>"
JWT_EXPIRES_IN="7d"

# Generate 256-bit cron authorization secret via: `openssl rand -hex 32`
CRON_SECRET="<GENERATE_SECURE_RANDOM_HEX_SECRET_FOR_CRON_JOBS>"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# 4. TELEGRAM BOT API & MINI APP (REQUIRED FOR BOT/MINIAPP OPERATIONS)
# ------------------------------------------------------------------------------
# Dedicated bot tokens obtained from @BotFather
TELEGRAM_CLIENT_BOT_TOKEN="<YOUR_CLIENT_MINIAPP_BOT_TOKEN_FROM_BOTFATHER>"
TELEGRAM_DRIVER_BOT_TOKEN="<YOUR_DRIVER_BOT_TOKEN_FROM_BOTFATHER>"
TELEGRAM_MANAGER_BOT_TOKEN="<OPTIONAL_MANAGER_BOT_TOKEN>"

# Manager shared group chat ID (e.g. -1003893397086) for team notifications
TELEGRAM_MANAGER_GROUP_CHAT_ID="<OPTIONAL_TELEGRAM_GROUP_CHAT_ID_E_G_-1003893397086>"
TELEGRAM_ENABLE_GROUP_NOTIFICATIONS=true

# Webhook Secret Token (sent in X-Telegram-Bot-Api-Secret-Token)
# Generate via: `openssl rand -hex 24`
TELEGRAM_BOT_WEBHOOK_SECRET="<GENERATE_RANDOM_HEX_SECRET_FOR_WEBHOOK>"

# ------------------------------------------------------------------------------
# 5. GOOGLE SHEETS API (REQUIRED FOR ACCOUNTING SYNC)
# ------------------------------------------------------------------------------
# Service Account details from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL="<YOUR_SERVICE_ACCOUNT>@<YOUR_PROJECT_ID>.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<YOUR_RSA_PRIVATE_KEY_CONTENT>\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID="<YOUR_GOOGLE_SHEETS_SPREADSHEET_ID>"
GOOGLE_SHEETS_SHEET_NAME="Заявки"

# ------------------------------------------------------------------------------
# 6. S3 OBJECT STORAGE (REQUIRED FOR CLOUD PHOTO ARCHIVE)
# ------------------------------------------------------------------------------
# S3 endpoint (Yandex Object Storage, AWS S3, MinIO, Selectel)
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET="<YOUR_PRIVATE_S3_BUCKET_NAME>"
S3_ACCESS_KEY_ID="<YOUR_S3_ACCESS_KEY_ID>"
S3_SECRET_ACCESS_KEY="<YOUR_S3_SECRET_ACCESS_KEY>"
S3_FORCE_PATH_STYLE="false"
