# ==============================================================================
# ALIBROS LOGISTICS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to .env.local for local development.
# 2. Never commit actual secret keys, passwords, or tokens to version control!
# ==============================================================================

# Application & Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Logging
# Levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=debug

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alibros_logistics?schema=public"

# Authentication & Security
# Generate secure 256-bit secret: `openssl rand -base64 32`
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# Telegram Bot API & Mini App Integration
# Bot tokens obtained from @BotFather
TELEGRAM_CLIENT_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_client"
TELEGRAM_DRIVER_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_driver"
TELEGRAM_MANAGER_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_manager"
TELEGRAM_BOT_WEBHOOK_SECRET="replace-with-webhook-secret"

# Google Sheets API Integration (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@alibros-logistics.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID="replace-with-google-sheets-spreadsheet-id"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# S3 Object Storage (AWS S3, Yandex Object Storage, MinIO, Selectel)
# Bucket must be private (ACL: private). Access is strictly mediated via signed URLs and RBAC.
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET="alibros-delivery-photos"
S3_ACCESS_KEY_ID="replace-with-s3-access-key-id"
S3_SECRET_ACCESS_KEY="replace-with-s3-secret-access-key"
S3_FORCE_PATH_STYLE="false"

