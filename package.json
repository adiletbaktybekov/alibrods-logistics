{
  "name": "alibros-logistics",
  "version": "0.1.0",
  "private": true,
  "description": "Commercial logistics platform for WB and Ozon sellers - AliBros Logistics",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js validate",
    "prisma:migrate:deploy": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:migrate:status": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js migrate status",
    "prisma:seed": "node --env-file-if-exists=.env.local --experimental-strip-types prisma/seed.ts",
    "db:target": "node --env-file-if-exists=.env.local scripts/check-db-target.js",
    "sheets": "node --env-file-if-exists=.env.local scripts/verify-google-sheets.js",
    "sheets:verify": "node --env-file-if-exists=.env.local scripts/verify-google-sheets.js",
    "sheets:setup": "node --env-file-if-exists=.env.local scripts/setup-google-sheet.js",
    "sheets:protect": "node --env-file-if-exists=.env.local scripts/protect-google-sheet.js",
    "r2:verify": "node --env-file-if-exists=.env.local scripts/verify-r2-storage.js",
    "e2e:tc-e01": "node --env-file-if-exists=.env.local scripts/run-tc-e01.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@prisma/client": "^6.4.1",
    "argon2": "^0.45.2",
    "clsx": "^2.1.1",
    "jose": "^6.0.8",
    "next": "15.2.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.2.1",
    "postcss": "^8.5.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
